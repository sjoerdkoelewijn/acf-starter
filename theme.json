{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,

		"background": {
			"backgroundImage": false,
			"backgroundSize": false
		},

		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},

		"color": {
			"background": false,
			"button": false,
			"caption": false,
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"heading": false,
			"link": false,
			"text": false,
			"palette": [
				{ "slug": "base",     "name": "Base",     "color": "#ffffff" },
				{ "slug": "contrast", "name": "Contrast", "color": "#111111" },
				{ "slug": "muted",    "name": "Muted",    "color": "#6b6b6b" },
				{ "slug": "surface",  "name": "Surface",  "color": "#f5f5f4" },
				{ "slug": "line",     "name": "Line",     "color": "#e4e4e2" },
				{ "slug": "accent",   "name": "Accent",   "color": "#111111" },
				{ "slug": "sale",     "name": "Sale",     "color": "#b42318" }
			]
		},

		"dimensions": {
			"aspectRatio": false,
			"minHeight": false
		},

		"layout": {
			"contentSize": "46rem",
			"wideSize": "80rem",
			"allowCustomContentAndWideSize": false
		},

		"position": {
			"sticky": false
		},

		"shadow": {
			"defaultPresets": false,
			"presets": []
		},

		"spacing": {
			"blockGap": true,
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"margin": false,
			"padding": false,
			"units": [],
			"spacingSizes": [
				{ "slug": "20", "name": "1 - Tiny",  "size": "0.5rem" },
				{ "slug": "30", "name": "2 - Small", "size": "1rem" },
				{ "slug": "40", "name": "3 - Base",  "size": "1.5rem" },
				{ "slug": "50", "name": "4 - Large", "size": "3rem" },
				{ "slug": "60", "name": "5 - Huge",  "size": "5rem" }
			]
		},

		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": false,
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"lineHeight": false,
			"textColumns": false,
			"textDecoration": false,
			"textTransform": false,
			"writingMode": false,
			"fontSizes": [
				{ "slug": "small",    "name": "Small",    "size": "0.875rem" },
				{ "slug": "medium",   "name": "Medium",   "size": "1rem" },
				{ "slug": "large",    "name": "Large",    "size": "1.25rem" },
				{ "slug": "x-large",  "name": "X Large",  "size": "1.75rem" },
				{ "slug": "xx-large", "name": "XX Large", "size": "2.5rem" }
			]
		},

		"custom": {
			"fontFamily": {
				"sans": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
				"mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
			},
			"radius": {
				"sm": "2px",
				"md": "4px",
				"lg": "10px",
				"pill": "999px"
			},
			"transition": "160ms ease",
			"header": {
				"height": "4.5rem"
			},
			"grid": {
				"min": "15rem"
			}
		}
	},

	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--custom--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "var(--wp--custom--radius--md)" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "textDecoration": "none" },
				":hover": { "color": { "background": "var(--wp--preset--color--contrast)" } }
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			},
			"core/quote": {
				"border": { "left": { "width": "2px", "style": "solid", "color": "var(--wp--preset--color--line)" } },
				"spacing": { "padding": { "left": "var(--wp--preset--spacing--40)" } }
			},
			"core/table": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		}
	}
}
