{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "acf/contact",
  "title": "Contact",
  "description": "Contact details next to a form.",
  "category": "sgwrd-blocks",
  "icon": "email",
  "keywords": [
    "contact",
    "address",
    "form"
  ],
  "textdomain": "acf-starter",
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "alignWide": true,
    "color": false,
    "spacing": false,
    "typography": false,
    "customClassName": true,
    "className": true,
    "html": false,
    "jsx": false,
    "multiple": true,
    "reusable": false
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "wide"
    }
  },
  "acf": {
    "blockVersion": 3,
    "renderPreview": true,
    "renderTemplate": "render.php"
  }
}
